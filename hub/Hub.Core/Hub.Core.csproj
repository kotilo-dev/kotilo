<Project Sdk="Microsoft.NET.Sdk">
  <!-- UI-independent core. Must not reference WinUI, ASP.NET Core or SQLite (spec §3). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <!-- Brand.Current (Directory.Build.props points at the repo's brand.json). -->
    <EmbeddedResource Include="$(BrandJsonPath)" LogicalName="brand.json" Link="brand.json" />
  </ItemGroup>
</Project>
