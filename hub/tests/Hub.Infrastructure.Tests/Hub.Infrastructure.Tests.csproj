<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CA1707;CA1515;CA2007</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="FluentAssertions" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Hub.Infrastructure\Hub.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Hub.Core.Tests\Fixtures\codex\rollout.jsonl" Link="Fixtures\codex\rollout.jsonl" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Hub.Core.Tests\Fixtures\copilot\events.jsonl" Link="Fixtures\copilot\events.jsonl" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
