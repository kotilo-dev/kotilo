{
  "$schema": "../../schema/adapter.v1.json",
  "v": 1,
  "id": "droid",
  "displayName": "Factory Droid",
  "avatar": { "letter": "D", "bg": "#2b2620", "ink": "#f2b56b" },
  "detect": { "executables": ["droid.exe", "droid"], "nodeScripts": ["node_modules/droid/"] },
  "launch": { "command": "droid", "args": [], "resumeArgs": ["--resume", "{sessionId}"] },
  "gracefulClose": [
    { "keys": "Ctrl+C", "waitMs": 500 },
    { "keys": "Ctrl+C", "repeat": 2, "gapMs": 200, "waitMs": 3000 }
  ],
  "hooks": {
    "shell": "cmd",
    "events": [
      "SessionStart", "SessionEnd", "UserPromptSubmit", "PreToolUse", "PostToolUse", "Notification", "Stop",
      "SubagentStop", "PreCompact"
    ]
  },
  "usage": "builtIn",
  "context": {
    "instructions": [
      { "scope": "user", "path": "~/.factory/AGENTS.md" },
      { "scope": "user", "path": "~/.agents/AGENTS.md" },
      { "scope": "user", "path": "~/.agent/AGENTS.md" },
      { "scope": "project", "names": ["AGENTS.md", ".factory/AGENTS.md", ".agents/AGENTS.md", ".agent/AGENTS.md"], "walk": "repo", "nested": true }
    ],
    "skills": [
      { "scope": "project", "dir": ".factory/skills" },
      { "scope": "project", "dir": ".agents/skills" },
      { "scope": "user", "dir": "~/.factory/skills" },
      { "scope": "user", "dir": "~/.agents/skills" }
    ],
    "mcp": [
      { "scope": "user", "path": "~/.factory/mcp.json", "format": "json", "pointer": "/mcpServers" },
      { "scope": "project", "path": ".factory/mcp.json", "format": "json", "pointer": "/mcpServers" }
    ]
  }
}
