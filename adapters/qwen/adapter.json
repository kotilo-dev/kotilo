{
  "$schema": "../../schema/adapter.v1.json",
  "v": 1,
  "id": "qwen",
  "displayName": "Qwen Code",
  "avatar": { "letter": "Q", "bg": "#262236", "ink": "#b39cf5" },
  "detect": { "executables": ["qwen.cmd", "qwen"], "nodeScripts": ["@qwen-code/qwen-code"] },
  "launch": { "command": "qwen", "args": [], "resumeArgs": ["--resume", "{sessionId}"] },
  "gracefulClose": [{ "keys": "Ctrl+C", "repeat": 3, "gapMs": 400, "waitMs": 3000 }],
  "permissionKeys": { "allowOnce": "1", "alwaysAllow": "2", "deny": "Esc" },
  "hooks": {
    "shell": "cmdUnquoted",
    "events": [
      "SessionStart", "SessionEnd", "UserPromptSubmit", "PreToolUse", "PostToolUse", "PostToolUseFailure",
      "Notification", "Stop", "StopFailure"
    ]
  },
  "usage": "builtIn",
  "context": {
    "instructions": [
      { "scope": "user", "path": "~/.qwen/QWEN.md", "imports": true },
      { "scope": "project", "names": ["AGENTS.md", "QWEN.md", ".qwen/QWEN.local.md"], "walk": "repo", "imports": true }
    ],
    "skills": [
      { "scope": "user", "dir": "~/.qwen/skills" },
      { "scope": "user", "dir": "~/.agents/skills" },
      { "scope": "project", "dir": ".qwen/skills" },
      { "scope": "project", "dir": ".agents/skills" }
    ],
    "mcp": [
      { "scope": "user", "path": "~/.qwen/settings.json", "format": "jsonc", "pointer": "/mcpServers" },
      { "scope": "project", "path": ".qwen/settings.json", "format": "jsonc", "pointer": "/mcpServers" }
    ]
  }
}
