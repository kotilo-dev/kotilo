{
  "$schema": "../../schema/adapter.v1.json",
  "v": 1,
  "id": "cursor",
  "displayName": "Cursor CLI",
  "avatar": { "letter": "U", "bg": "#21252b", "ink": "#d3dae3" },
  "detect": { "executables": ["cursor-agent.exe", "cursor-agent"], "nodeScripts": ["/cursor-agent/"] },
  "launch": { "command": "cursor-agent", "args": [], "resumeArgs": ["--resume", "{sessionId}"] },
  "gracefulClose": [{ "keys": "Ctrl+D", "repeat": 2, "gapMs": 200, "waitMs": 3000 }],
  "permissionKeys": { "allowOnce": "y", "deny": "n" },
  "hooks": {
    "shell": "any",
    "events": ["sessionStart", "sessionEnd", "postToolUse", "afterShellExecution", "afterFileEdit", "stop"]
  },
  "usage": "none",
  "screenRules": [
    {
      "id": "permission",
      "state": "waitingPermission",
      "pattern": "\\(y\\)[\\s\\S]*\\((?:esc or )?n\\)|\\(y/n\\)",
      "lines": 10
    }
  ],
  "context": {
    "instructions": [
      { "scope": "project", "names": ["AGENTS.md", "CLAUDE.md"], "walk": "root" }
    ],
    "rules": [
      { "scope": "project", "glob": ".cursor/rules/**/*.mdc" }
    ],
    "skills": [
      { "scope": "project", "dir": ".agents/skills" },
      { "scope": "project", "dir": ".cursor/skills" },
      { "scope": "project", "dir": ".claude/skills" },
      { "scope": "project", "dir": ".codex/skills" },
      { "scope": "user", "dir": "~/.agents/skills" },
      { "scope": "user", "dir": "~/.cursor/skills" },
      { "scope": "user", "dir": "~/.claude/skills" },
      { "scope": "user", "dir": "~/.codex/skills" }
    ],
    "mcp": [
      { "scope": "project", "path": ".cursor/mcp.json", "format": "json", "pointer": "/mcpServers" },
      { "scope": "user", "path": "~/.cursor/mcp.json", "format": "json", "pointer": "/mcpServers" }
    ]
  }
}
