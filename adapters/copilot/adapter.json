{
  "$schema": "../../schema/adapter.v1.json",
  "v": 1,
  "id": "copilot",
  "displayName": "GitHub Copilot CLI",
  "avatar": { "letter": "P", "bg": "#1f2430", "ink": "#a5c8ff" },
  "detect": { "executables": ["copilot.exe", "copilot"], "nodeScripts": ["@github/copilot"] },
  "launch": { "command": "copilot", "args": [], "resumeArgs": ["--resume", "{sessionId}"] },
  "gracefulClose": [{ "keys": "Ctrl+C", "repeat": 2, "gapMs": 400, "waitMs": 3000 }],
  "permissionKeys": { "allowOnce": "1", "deny": "Esc" },
  "hooks": {
    "shell": "powershell",
    "events": [
      "sessionStart", "sessionEnd", "userPromptSubmitted", "postToolUse", "permissionRequest", "notification", "agentStop",
      "errorOccurred"
    ]
  },
  "usage": "builtIn",
  "context": {
    "instructions": [
      { "scope": "user", "path": "~/.copilot/copilot-instructions.md" },
      { "scope": "user", "glob": "~/.copilot/instructions/**/*.instructions.md" },
      { "scope": "project", "path": ".github/copilot-instructions.md" },
      { "scope": "project", "names": ["AGENTS.md", "CLAUDE.md", ".claude/CLAUDE.md", "GEMINI.md"], "walk": "repo", "nested": true }
    ],
    "rules": [
      { "scope": "project", "glob": ".github/instructions/**/*.instructions.md" }
    ],
    "skills": [
      { "scope": "project", "dir": ".github/skills" },
      { "scope": "project", "dir": ".claude/skills" },
      { "scope": "project", "dir": ".agents/skills" },
      { "scope": "user", "dir": "~/.copilot/skills" },
      { "scope": "user", "dir": "~/.agents/skills" }
    ],
    "mcp": [
      { "scope": "user", "path": "~/.copilot/mcp-config.json", "format": "json", "pointer": "/mcpServers" },
      { "scope": "project", "path": ".mcp.json", "format": "json", "pointer": "/mcpServers", "walk": "repo" },
      { "scope": "project", "path": ".github/mcp.json", "format": "json", "pointer": "/mcpServers" }
    ]
  }
}
