{
  "$schema": "../../schema/adapter.v1.json",
  "v": 1,
  "id": "claude-code",
  "displayName": "Claude Code",
  "avatar": { "letter": "C", "bg": "#2a2230", "ink": "#f0a37d" },
  "detect": { "executables": ["claude.exe", "claude"], "nodeScripts": ["@anthropic-ai/claude-code"] },
  "launch": { "command": "claude", "args": [], "resumeArgs": ["--resume", "{sessionId}"] },
  "gracefulClose": [{ "keys": "Ctrl+C", "repeat": 3, "gapMs": 400, "waitMs": 3000 }],
  "permissionKeys": { "allowOnce": "1", "alwaysAllow": "2", "deny": "Esc" },
  "hooks": {
    "shell": "cmd",
    "events": [
      "SessionStart", "UserPromptSubmit", "PreToolUse", "PostToolUse", "PostToolUseFailure", "PermissionRequest",
      "Notification", "Stop", "StopFailure", "SubagentStart", "SubagentStop", "SessionEnd"
    ]
  },
  "usage": "builtIn",
  "screenRules": [
    {
      "id": "permission-dialog",
      "state": "waitingPermission",
      "pattern": "Do you want to [^\\n]{1,200}\\?[^\\n]*\\n(?:[^\\n]*\\n){0,4}[ \\t│❯›>]*1\\. Yes|Do you want to [^\\n]{1,200}\\?(?:[^\\n]*\\n){1,12}[^\\n]*Esc to cancel",
      "lines": 14
    }
  ]
}
