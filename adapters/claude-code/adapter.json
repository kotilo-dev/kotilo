{
  "$schema": "../../schema/adapter.v1.json",
  "v": 1,
  "id": "claude-code",
  "displayName": "Claude Code",
  "avatar": { "letter": "C", "bg": "#2a2230", "ink": "#f0a37d" },
  "detect": { "executables": ["claude.exe", "claude"], "nodeScripts": ["@anthropic-ai/claude-code"] },
  "launch": { "command": "claude", "args": [], "resumeArgs": ["--resume", "{sessionId}"] },
  "gracefulClose": [{ "keys": "Ctrl+C", "repeat": 3, "gapMs": 400, "waitMs": 3000 }],
  "permissionKeys": { "allowOnce": "1", "alwaysAllow": "2", "deny": "Esc" },
  "hooks": {
    "shell": "cmd",
    "events": [
      "SessionStart", "UserPromptSubmit", "PreToolUse", "PostToolUse", "PostToolUseFailure", "PermissionRequest",
      "Notification", "Stop", "StopFailure", "SubagentStart", "SubagentStop", "SessionEnd"
    ]
  },
  "usage": "builtIn",
  "screenRules": [
    {
      "id": "permission-dialog",
      "state": "waitingPermission",
      "pattern": "Do you want to [^\\n]{1,200}\\?[^\\n]*\\n(?:[^\\n]*\\n){0,4}[ \\t│❯›>]*1\\. Yes|Do you want to [^\\n]{1,200}\\?(?:[^\\n]*\\n){1,12}[^\\n]*Esc to cancel",
      "lines": 14
    }
  ],
  "context": {
    "instructions": [
      { "scope": "managed", "path": "C:/Program Files/ClaudeCode/CLAUDE.md", "os": "windows", "imports": true },
      { "scope": "managed", "path": "/Library/Application Support/ClaudeCode/CLAUDE.md", "os": "macos", "imports": true },
      { "scope": "managed", "path": "/etc/claude-code/CLAUDE.md", "os": "linux", "imports": true },
      { "scope": "user", "path": "~/.claude/CLAUDE.md", "imports": true },
      { "scope": "project", "names": ["CLAUDE.md", ".claude/CLAUDE.md", "CLAUDE.local.md"], "walk": "ancestors", "nested": true, "imports": true },
      { "scope": "project", "names": ["AGENTS.md"], "walk": "ancestors", "fallback": true }
    ],
    "rules": [
      { "scope": "user", "glob": "~/.claude/rules/**/*.md" },
      { "scope": "project", "glob": ".claude/rules/**/*.md" }
    ],
    "skills": [
      { "scope": "user", "dir": "~/.claude/skills" },
      { "scope": "project", "dir": ".claude/skills" }
    ],
    "mcp": [
      { "scope": "project", "path": ".mcp.json", "format": "json", "pointer": "/mcpServers" },
      { "scope": "user", "path": "~/.claude.json", "format": "json", "pointer": "/mcpServers", "projectPointer": true }
    ]
  }
}
