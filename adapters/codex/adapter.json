{
  "$schema": "../../schema/adapter.v1.json",
  "v": 1,
  "id": "codex",
  "displayName": "Codex CLI",
  "avatar": { "letter": "X", "bg": "#1d2a26", "ink": "#7fd8b4" },
  "detect": { "executables": ["codex.exe", "codex"], "nodeScripts": ["@openai/codex"] },
  "launch": { "command": "codex", "args": [], "resumeArgs": ["resume", "{sessionId}"] },
  "permissionKeys": { "allowOnce": "y", "alwaysAllow": "p", "deny": "Esc" },
  "hooks": {
    "shell": "cmdUnquoted",
    "events": [
      "SessionStart", "SessionEnd", "UserPromptSubmit", "PreToolUse", "PermissionRequest", "PostToolUse",
      "PostCompact", "Stop", "Interrupt", "SubagentStart", "SubagentStop"
    ]
  },
  "usage": "builtIn",
  "context": {
    "instructions": [
      { "scope": "user", "names": ["AGENTS.override.md", "AGENTS.md"], "dir": "~/.codex", "pick": "first" },
      { "scope": "project", "names": ["AGENTS.override.md", "AGENTS.md"], "walk": "repo", "pick": "first" }
    ],
    "skills": [
      { "scope": "project", "dir": ".agents/skills", "walk": "repo" },
      { "scope": "user", "dir": "~/.agents/skills" }
    ],
    "mcp": [
      { "scope": "user", "path": "~/.codex/config.toml", "format": "toml", "pointer": "/mcp_servers" },
      { "scope": "project", "path": ".codex/config.toml", "format": "toml", "pointer": "/mcp_servers" }
    ],
    "maxBytes": 32768
  }
}
